	(text "Icorms = (Vout * (Vin - Vout)) / (sqrt(12) * Vin * Lo * fsw)\n = 6 * (14.4 - 6) / (3.464 * 14.4 * 3.3e-6 * 588e3)\n = 0.521A"
		(at 190.754 49.276 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a03dd27c-b8ea-4764-ab64-876d602efda9")
