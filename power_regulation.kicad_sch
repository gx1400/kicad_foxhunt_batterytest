	(text "(Ref C2)"
		(at 60.706 76.454 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "aaa6f6b5-ae66-4f6e-b82d-b9b07ba33482")
	)
	(text "fsw = 588kHz from Section 5-5 or ~600kHz from Tables 5-6\n\nIIp-p = (Vout/Vinmax) * ((Vinmax - Vout) / (Lo * fSw))\n = (4.3/14.4) * ((14.4 -4.3) / (3.3e-6 * 588e3))\n = 0.299 * (10/1 / 1.9404) = 1.556A\n\nIIpk = Io + IIp-p/2\n     = 1 + (1.556/2) = 1.77A\n\nILO = sqrt(Io^2 + (1/12)(IIp-p)^2) = 1.12A"
		(at 222.25 109.22 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
		)
		(uuid "aacc481b-a2b8-4d9d-9b14-feb2dcf6bba9")
	)
	(text "(Ref C9)"
		(at 170.434 69.596 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ad83a23b-fb0b-4ee3-8f62-dc6a60c876c4")
	)
	(text "fsw = 588kHz from Section 5-5 or ~600kHz from Tables 5-6\n\nIIp-p = (Vout/Vinmax) * ((Vinmax - Vout) / (Lo * fSw))\n = (6/14.4) * ((14.4 -6) / (3.3e-6 * 588e3))\n = 0.416 * (8.4 / 1.9404) = 1.8A\n\nIIpk = Io + IIp-p/2\n     = 2 + (1.8/2) = 2.9A\n\nILO = sqrt(Io^2 + (1/12)(IIp-p)^2) = 2.066"
		(at 220.98 31.75 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
		)
		(uuid "b4cbae52-9dfa-4177-a2d6-bb7e9997ad10")
	)
