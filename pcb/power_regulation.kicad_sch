	)
	(text "fsw = 588kHz from Section 5-5 or ~600kHz from Tables 5-6\n\nIIp-p = (Vout/Vinmax) * ((Vinmax - Vout) / (Lo * fSw))\n = (6.6/14.4) * ((14.4 -6.6) / (3.3e-6 * 588e3))\n = 0.458 * (7.8 / 1.9404) = 1.84A\n\nIIpk = Io + IIp-p/2\n     = 2 + (1.84/2) = 2.92A\n\nILO = sqrt(Io^2 + (1/12)(IIp-p)^2) = 2.07"
		(exclude_from_sim no)
		(at 209.55 30.226 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
		)
		(uuid "dfeab00d-b40f-48bc-af09-9abf65e4aa19")
	)
	(text "(Ref C7)"
		(exclude_from_sim no)
		(at 123.19 63.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e9837b9f-fe27-408b-ba24-cf7e8562b6de")
	)
	(text "Vout = 0.768 (1 + R1/R2) <= R2=10k\n6.6 = 0.768(1+R1/10k) \n=> R1 = 76k -> 76.8k\n=> R2 = 10k\n\nL = 3.3uH typ from Table 7-2"
		(exclude_from_sim no)
		(at 155.956 32.766 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
		)
		(uuid "ed615a89-6c99-4976-aa39-3b52546f4953")
	)
	(text "3.3V rail:\n\nBuck pre-regulator: second TPS563201, set to ~4.3V @ 1A intermediate output\nLDO cleanup stage: LM1085-3.3 (fixed 3.3V, 3A rated), taking the 4.3V intermediate down to a clean 3.3V"
		(exclude_from_sim no)
		(at 90.424 107.188 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f757bec9-71f3-4178-9ab8-4ff8a3ca1a33")
	)
