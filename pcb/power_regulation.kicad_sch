	(text "Vout = 0.768 (1 + R1/R2) <= R2=10k\n4.7 = 0.768(1+R1/10k) \n=> R1 = 51.2k => 52.3k\n=> R2 = 10k\n= 4.78V\n\nL = 3.3uH typ from Table 7-2"
		(exclude_from_sim no)
		(at 172.72 110.998 0)
