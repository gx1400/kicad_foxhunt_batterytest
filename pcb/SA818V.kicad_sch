	(text "IN_PTT assert HI \n  => Transmit"
		(exclude_from_sim no)
		(at 29.972 128.524 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0810f371-f6d0-471c-b4e9-ce147777b309")
	)
	(text "Tip = MIC Audio\nRing 1 = Audio In (not used)\nRing 2 = PTT\nShield = GND\n\nTN = To SA818 MIC\nR1N = Not used\nR2N = To SA818 PTT\nSN = to Peripheral GPIO"
		(exclude_from_sim no)
		(at 258.826 144.526 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "11c1bb6a-af6a-4f08-a8d6-461c7a5a64d8")
	)
	(text "Tpw = K * Cext * Rext\n    = (0.45)(47uF)(470k)\n    = 9.45sec"
		(exclude_from_sim no)
		(at 115.316 111.506 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4c8a02e5-6101-4739-b127-4c649afd6a48")
	)
	(text "PTT_HB = 1Hz toggle"
		(exclude_from_sim no)
		(at 76.962 151.384 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "59413891-0d1e-493e-9ecb-1c534aca8ad1")
	)
	(text "Concern: MCU lock up leads to TX being held on\n\nTheory of Op:\n- After asserting PTT the MCU starts to send a 1Hz heartbeat\n- PTT starts a monostable pulse ~9s long\n- Each heartbeat rising edge resets the timer to 0\n- If PTT locks up and heartbeat stops, the timer will deassert after 10 sec\n- NAND gate inputs will not both be high, so output PTT will deassert"
		(exclude_from_sim no)
		(at 89.408 176.53 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "efefa24e-9b05-4430-94fb-0d6d88b05e93")
	)
